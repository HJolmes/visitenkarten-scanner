{
  "expo": {
    "name": "Visitenkarte",
    "slug": "visitenkarten-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.jolmes.visitenkarte"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.jolmes.visitenkarte",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Visitenkarte",
      "shortName": "Visitenkarte",
      "lang": "de"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Die Kamera wird gebraucht, um Visitenkarten zu fotografieren.",
          "photosPermission": "Zugriff auf Fotos, um eine fotografierte Visitenkarte auszuwählen.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Die Kamera wird gebraucht, um Visitenkarten zu fotografieren.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ]
  }
}
